# ── Supabase (Project Settings > API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude (console.anthropic.com) ──
ANTHROPIC_API_KEY=
# opcional: modelo (default claude-sonnet-5-5)
CLAUDE_MODEL=

# ── Transcripción ──
# local = Whisper gratis en la compu del worker (default). openai = por API (necesita OPENAI_API_KEY)
TRANSCRIBE_PROVIDER=local
# base | small | medium   (small es buen balance; medium más preciso pero más lento)
WHISPER_MODEL=small
OPENAI_API_KEY=

# ── Scraping de Instagram/TikTok (apify.com) ──
APIFY_TOKEN=
# opcionales
APIFY_IG_ACTOR=apify~instagram-reel-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# ── Worker de render ──
# true = se exporta sin pasar por revisión
AUTO_RENDER=false
# opcional: ruta a Chrome/Chromium si Remotion no descarga el suyo
REMOTION_BROWSER_EXECUTABLE=
REMOTION_CONCURRENCY=

# Flyers con IA (Google AI Studio → Get API key)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
